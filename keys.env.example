# 智谱 GLM
ZHIPU_API_KEY=xxx

# Kimi (月之暗面)
KIMI_API_KEY=sk-xxx

# MiMo (小米)
MIMO_API_KEY=sk-xxx

# Mistral
MISTRAL_API_KEY=sk-xxx
